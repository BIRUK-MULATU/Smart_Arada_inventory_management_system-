# Copy to .env and fill in. .env is gitignored — never commit it.

POSTGRES_DB=inventory
POSTGRES_USER=inventory
POSTGRES_PASSWORD=devpassword
DB_URL=jdbc:postgresql://localhost:55432/inventory

# Generate a real one with: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRY_MINUTES=60

# First admin account, created on startup if no active admin exists yet.
# Leave blank in production once the first admin has been created.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace-me-with-a-strong-password

CORS_ALLOWED_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080/api

# Optional: only needed to run `./mvnw org.owasp:dependency-check-maven:check`.
# Free key from https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# Production only (docker-compose.prod.yml). Your public domain - Caddy uses it to request a
# TLS cert, and it feeds CORS_ALLOWED_ORIGINS. Not used by local dev.
DOMAIN=

# Production only. Days of pg_dump backups to keep before the backup service prunes them.
RETENTION_DAYS=14
